# Образ для каталогов MCP (Glama и подобных): они собирают сервер из Dockerfile,
# и без успешной сборки листинг остаётся, но выпадает из поиска и рекомендаций.
#
# Сервер общается по stdio, поэтому ENTRYPOINT — сама команда, без обёрток:
# клиент запускает контейнер и разговаривает с ним через стандартный ввод-вывод.
FROM python:3.12-slim

WORKDIR /app

# Сначала только то, что нужно для установки — слой с зависимостями кэшируется
# и не пересобирается при правке кода.
COPY pyproject.toml README.md LICENSE ./
COPY kontragentpro_mcp ./kontragentpro_mcp

RUN pip install --no-cache-dir .

# Ключ не обязателен: анонимный бесплатный доступ включён по умолчанию.
# Чтобы поднять лимиты, передайте -e KONTRAGENTPRO_API_KEY=...
ENTRYPOINT ["kontragentpro-mcp"]
